# Each service runs live or on cached evidence from its own credential:
# Zetaris goes live when ZETARIS_API_KEY or a Zetaris account is set, Nightshift when
# METERLESS_RUNTIME_TOKEN is set. Leave SAMPLE_MODE unset to let each decide.
# SAMPLE_MODE=true forces both onto cached evidence; SAMPLE_MODE=false forces
# both live. GET /health reports sample_data, sample_model and the reason.
# SAMPLE_MODE=

# Zetaris REST SQL. Keep credentials in .env only.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# A local Zetaris issues tokens that expire within minutes. With an account set,
# Pluvia signs in itself and renews the token; the API key is then not needed.
ZETARIS_LOGIN_URL=http://localhost:3000/api/auth/login
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Nightshift. The NVIDIA provider key belongs only in Nightshift Providers.
# METERLESS_MODEL is a route listed by GET /v1/models. Pin a Nemotron route;
# meterless/auto can route calls to other vendors.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Sent as the user agent on NASA POWER requests; registration refuses the placeholder.
CONTACT_EMAIL=your-email@example.com
PORT=8000

# Zetaris in Docker reaches the host app through this URL.
REGISTER_BASE_URL=http://host.docker.internal:8000/register

# The claims agent's model routes through Nightshift. Defaults shown.
PLUVIA_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
PLUVIA_AGENT_FALLBACK=openrouter/openai/gpt-5.6-luna
